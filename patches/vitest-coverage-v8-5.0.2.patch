new file mode 100644
--- /dev/null
+++ b/dist/subprocess.cjs
@@ -0,0 +1,48 @@
+// Loaded only by descendants of an auto-attached coverage worker. This uses a
+// local inspector Session, never an inspector port. Each isolate owns its files.
+const { Session } = require('node:inspector');
+const { writeFileSync, renameSync } = require('node:fs');
+const { join } = require('node:path');
+const { threadId } = require('node:worker_threads');
+const directory = process.env.NODE_V8_COVERAGE;
+if (directory) {
+  const session = new Session();
+  const prefix = `source-${process.pid}-${threadId}-`;
+  let bytes = 0;
+  let scripts = 0;
+  function write(name, value) {
+    const path = join(directory, name);
+    writeFileSync(`${path}.tmp`, JSON.stringify(value), { mode: 0o600 });
+    renameSync(`${path}.tmp`, path);
+  }
+  function fail(error) {
+    write(`error-${process.pid}-${threadId}.json`, { error: String(error) });
+    session.disconnect();
+  }
+  session.connect();
+  session.on('Debugger.scriptParsed', ({ params }) => {
+    // Match the provider's early native-coverage filter. No dependencies,
+    // builtins, virtual Vite modules, or non-file scripts are retained.
+    if (!params.url.startsWith('file://') || params.url.includes('/node_modules/')
+      || params.url.includes('/@id/@vitest/') || params.url.includes('/@vite/client')) return;
+    session.post('Debugger.getScriptSource', { scriptId: params.scriptId }, (error, result) => {
+      if (error) return fail(error);
+      // Bound retained code per isolate. Exceeding the bound invalidates the
+      // report visibly; it must never turn executed code into uncovered code.
+      bytes += Buffer.byteLength(result.scriptSource);
+      if (++scripts > 8192 || bytes > 64 * 1024 * 1024) return fail('Subprocess coverage source limit exceeded');
+      try {
+        write(`${prefix}${params.scriptId}.json`, {
+          pid: process.pid, threadId, scriptId: params.scriptId,
+          url: params.url, code: result.scriptSource, sourceMapURL: params.sourceMapURL || null,
+        });
+      } catch (error) {
+        fail(error);
+      }
+    });
+  });
+  session.post('Debugger.enable', {}, error => { if (error) fail(error); });
+  // The Session owns no event-loop handle. Let isolate teardown release it:
+  // disconnecting in an exit listener discards Node's detailed native ranges
+  // before NODE_V8_COVERAGE is flushed.
+}
