{
    "$schema": "https://turbo.build/schema.json",
    "globalPassThroughEnv": [
        "GITHUB_ACTIONS",
        "COMPOSE_PROJECT_NAME"
    ],
    "globalDependencies": [
        "packages/vitest-config/src/**",
        "packages/vitest-config/dist/**",
        "packages/test-logger/src/**"
    ],
    "tasks": {
        "start": {
            "cache": false,
            "persistent": true
        },
        "stop": {
            "cache": false
        },
        "reset": {
            "cache": false
        },
        "logs": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": [
                "^build",
                "gen:swagger-pages"
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "build/**"
            ]
        },
        "build:docker": {
            "dependsOn": [
                "build"
            ],
            "cache": false,
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": [
                "^build"
            ]
        },
        "lint:fix": {
            "dependsOn": [
                "^build"
            ]
        },
        "format": {
            "cache": false
        },
        "format:check": {
            "cache": false
        },
        "check": {
            "cache": false
        },
        "test": {
            "cache": true,
            "inputs": [
                "src/**",
                "test/**",
                "vitest.*.ts",
                "package.json",
                "package-lock.json"
            ],
            "dependsOn": [
                "^build",
                "^build:docker"
            ]
        },
        "test:unit": {
            "cache": true,
            "inputs": [
                "$TURBO_DEFAULT$"
            ],
            "outputs": [
                "coverage/unit/**"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "test:integration": {
            "cache": true,
            "inputs": [
                "$TURBO_DEFAULT$"
            ],
            "outputs": [
                "coverage/integration/**"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "test:e2e": {
            "cache": false,
            "inputs": [
                "src/**",
                "test/**",
                "playwright.config.ts",
                "vitest.*.ts",
                "package.json"
            ],
            "outputs": [
                "coverage/**",
                "playwright-report/**",
                "test-results/**"
            ],
            "dependsOn": [
                "^build",
                "^build:docker"
            ]
        },
        "check-types": {
            "dependsOn": ["^build"],
            "cache": true,
            "inputs": [
                "$TURBO_DEFAULT$"
            ]
        },
        "gen:swagger": {
            "cache": true,
            "inputs": [
                "src/**",
                "package.json",
                "package-lock.json",
                "tsconfig.json"
            ],
            "outputs": [
                "swagger.json"
            ]
        },
        "gen:swagger-pages": {
            "cache": true,
            "dependsOn": [
                "^gen:swagger"
            ],
            "outputs": [
                "content/docs/openapi/**"
            ]
        },
        "db:migrate": {
            "cache": false
        },
        "//#test:integration": {
            "dependsOn": [
                "@wallpaperdb/vitest-config#build"
            ],
            "inputs": [
                "package.json",
                "pnpm-lock.yaml",
                "vitest.integration.config.ts",
                "test/integration/**",
                "test/fixtures/crap/**",
                "$TURBO_ROOT$/apps/gateway/package.json",
                "$TURBO_ROOT$/packages/crap-typescript-core/src/**",
                "$TURBO_ROOT$/packages/crap-typescript-core/package.json"
            ],
            "outputs": []
        },
        "//#check-types": {
            "dependsOn": [
                "@wallpaperdb/vitest-config#build"
            ],
            "inputs": [
                "package.json",
                "pnpm-lock.yaml",
                "tsconfig.tooling.json",
                "scripts/crap.mts",
                "crap.config.mts",
                "test/integration/**",
                "vitest.integration.config.ts",
                "$TURBO_ROOT$/packages/crap-typescript-core/src/**",
                "$TURBO_ROOT$/packages/crap-typescript-core/package.json"
            ],
            "outputs": []
        }
    }
}
