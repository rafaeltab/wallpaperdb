{
	"name": "@wallpaperdb/scripts",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"bin": {
		"wallpaperdb-check-architecture": "./check-architecture.ts",
		"wallpaperdb-crap": "./crap.mts"
	},
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint . && node check-workspaces.mjs",
		"test:docker-queue": "cd .. && scripts/node_modules/.bin/vitest run scripts/docker-validation.test.ts",
		"test:toolchain": "cd .. && scripts/node_modules/.bin/vitest run scripts/toolchain.test.ts",
		"test:unit": "cd .. && scripts/node_modules/.bin/vitest run",
		"test:mutation": "node mutation.ts",
		"check-types": "tsc --project tsconfig.json && tsc --project tsconfig.external.json",
		"format:files": "biome format --write",
		"test:operator-inbox": "cd .. && scripts/node_modules/.bin/vitest run scripts/operator-inbox.test.ts",
		"test:files": "cd .. && scripts/node_modules/.bin/vitest run",
		"lint:docs": "node check-documentation.mjs",
		"lint:workspaces": "node check-workspaces.mjs",
		"lockfile:update": "cd .. && pnpm install --lockfile-only --ignore-scripts",
		"check:generated": "node check-generated.mjs",
		"check:migrations": "node check-migrations.mjs && node check-generated.mjs migrations",
		"check:migration-replay": "node docker-validation.mjs --label migration-replay -- node check-migration-replay.mjs",
		"agent": "node agent-workflow.mjs",
		"check:services": "node check-service-wiring.mjs",
		"dependencies:install": "cd .. && pnpm install --frozen-lockfile --ignore-scripts --filter @wallpaperdb/scripts..."
	},
	"dependencies": {
		"@wallpaperdb/crap-typescript-core": "workspace:*",
		"istanbul-lib-coverage": "3.2.2",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"remark-parse": "11.0.0",
		"unified": "11.0.5"
	},
	"devDependencies": {
		"@wallpaperdb/vitest-config": "workspace:*",
		"@biomejs/biome": "2.6.2",
		"@types/istanbul-lib-coverage": "2.0.6",
		"@types/node": "^26.0.1",
		"tsx": "^4.22.4",
		"typescript": "^5.7.2",
		"vitest": "5.0.2"
	}
}
