import { generatedRecordSchema, sourceMapSchema } from "./json.mjs";
import { readFile } from "node:fs/promises";
import { parse } from "acorn";
import { fileURLToPath, pathToFileURL } from "node:url";
import { sourceKey } from "./native-sources.mjs";

import { mockSourceMap } from "./mock-source-map.mjs";

import candidate from "ast-v8-to-istanbul";
// Vitest 5 native mocks generate a proxy under the application's URL, but its
// coverage provider supplies the original disk source for that proxy. Manual
// proxies use verified generated bytes; unqualified kinds remain rejected.
export default async function convert(
	options: Parameters<typeof candidate>[0],
): ReturnType<typeof candidate> {
	if (
		["manual", "automock", "autospy"].includes(
			new URL(options.coverage.url).searchParams.get("mock") || "",
		) &&
		process.env.WALLPAPERDB_COVERAGE_NATIVE_SOURCES
	) {
		const key = sourceKey(options.coverage.url);
		const record = generatedRecordSchema.parse(
			JSON.parse(
				await readFile(
					`${process.env.WALLPAPERDB_COVERAGE_NATIVE_SOURCES}/${key}.json`,
					"utf8",
				),
			),
		);
		if (record.url !== options.coverage.url)
			throw new Error("Generated source identity mismatch");
		if (new URL(options.coverage.url).searchParams.get("mock") !== "manual") {
			const inline = [
				...record.code.matchAll(
					/sourceMappingURL=data:application\/json;base64,([^\s]+)/g,
				),
			].at(-1)?.[1];
			if (!inline)
				throw new Error("NATIVE_MOCK_SOURCE_MISMATCH: generated map missing");
			const outer = sourceMapSchema.parse(
				JSON.parse(Buffer.from(inline, "base64").toString()),
			);
			if (outer.sources?.[0] !== fileURLToPath(options.coverage.url))
				throw new Error(
					"NATIVE_MOCK_SOURCE_MISMATCH: generated map origin differs from loaded application",
				);
			const code = await readFile(fileURLToPath(options.coverage.url), "utf8");
			const mapName = [...code.matchAll(/sourceMappingURL=([^\s]+)/g)].at(
				-1,
			)?.[1];
			if (!mapName)
				throw new Error("NATIVE_MOCK_SOURCE_MISMATCH: application map missing");
			const inner = sourceMapSchema.parse(
				JSON.parse(
					await readFile(new URL(mapName, options.coverage.url), "utf8"),
				),
			);
			const map = mockSourceMap(
				outer,
				inner,
				code,
				record.code,
				`${process.env.WALLPAPERDB_COVERAGE_NATIVE_SOURCES}/${key}.js`,
			);
			return candidate({
				...options,
				code: record.code,
				ast: parse(record.code, {
					ecmaVersion: "latest",
					sourceType: "module",
				}),
				sourceMap: map,
			});
		}
		// Synthetic proxy bytes have no original application source correspondence.
		// Keep their measurements under their own explicit identity. The provider's
		// complete inventory then adds unexecuted original source with zero counts.
		return candidate({
			...options,
			code: record.code,
			ast: parse(record.code, { ecmaVersion: "latest", sourceType: "module" }),
			sourceMap: undefined,
			coverage: {
				...options.coverage,
				url: pathToFileURL(
					`${process.env.WALLPAPERDB_COVERAGE_NATIVE_SOURCES}/${key}.js`,
				).href,
			},
		});
	}

	if (
		["manual", "automock", "autospy"].includes(
			new URL(options.coverage.url).searchParams.get("mock") || "",
		)
	) {
		throw new Error(
			"NATIVE_MOCK_SOURCE_MISMATCH: application mock proxy cannot be attributed to original disk source; retain the Vite runner for this suite",
		);
	}

	return candidate(options);
}
