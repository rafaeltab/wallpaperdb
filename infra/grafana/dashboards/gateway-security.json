        {
          "expr": "sum by (reason) (rate(admission_quota_saturated_total[$__rate_interval]))",
          "legendFormat": "Saturation {{reason}}",
          "refId": "C"
        },
        {
          "expr": "sum(rate(admission_quota_disabled_total[$__rate_interval]))",
          "legendFormat": "Disabled enforcement",
          "refId": "D"
        }
      ]
    },
