{
    "name": "@wallpaperdb/root",
    "version": "0.0.1",
    "type": "module",
    "packageManager": "pnpm@10.18.3",
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
    },
    "scripts": {
        "postinstall": "test -f scripts/setup-worktree.ts && node scripts/setup-worktree.ts || true",
        "test": "vitest",
        "architecture:workspaces": "node scripts/check-architecture-workspaces.ts",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "coverage:merge": "node scripts/merge-coverage.ts",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "check-types": "tsc --project tsconfig.tooling.json",
        "lint": "biome lint test",
        "format": "biome format --write test/integration/*.ts vitest*.ts tsconfig.tooling.json",
        "experiment:coverage:prepare": "node scripts/coverage-experiment/prepare.mjs && node scripts/coverage-experiment/build.mjs",
        "experiment:coverage:converter": "node scripts/coverage-experiment/converter.test.mjs",
        "experiment:coverage:format": "biome format --write scripts/coverage-experiment",
        "experiment:coverage:verify": "node scripts/coverage-experiment/verify.mjs",
        "experiment:coverage:joins": "node scripts/coverage-experiment/async-join.test.mjs",
        "experiment:coverage:information": "node scripts/coverage-experiment/information-loss.test.mjs",
        "experiment:coverage:generator": "node scripts/coverage-experiment/generator.test.mjs",
        "experiment:coverage:upstream": "node scripts/coverage-experiment/upstream.test.mjs",
        "experiment:coverage:differential": "node scripts/coverage-experiment/differential.test.mjs",
        "experiment:coverage:production-shape": "node scripts/coverage-experiment/production-shape.test.mjs",
        "experiment:coverage:user": "node scripts/coverage-experiment/user.mjs",
        "experiment:coverage:upstream-reference": "node scripts/coverage-experiment/upstream-reference.test.mjs",
        "experiment:coverage:accept": "node scripts/coverage-experiment/acceptance.mjs",
        "experiment:coverage:native-guard": "node scripts/coverage-experiment/native-guard.test.mjs",
        "experiment:coverage:mock-diagnostic": "node scripts/coverage-experiment/mock-attribution.test.mjs",
        "experiment:coverage:yield-join": "node scripts/coverage-experiment/yield-join.test.mjs",
        "experiment:coverage:report-validation": "node scripts/coverage-experiment/report-validation.test.mjs",
        "experiment:coverage:recovery-replay": "node scripts/coverage-experiment/recovery-replay.test.mjs",
        "experiment:coverage:node": "node scripts/coverage-experiment/node.mjs",
        "experiment:coverage:clean-env": "node scripts/coverage-experiment/coverage-env.test.mjs",
        "experiment:coverage:auto-provenance": "node scripts/coverage-experiment/auto-provenance.test.mjs",
        "experiment:coverage:recorded-layouts": "node scripts/coverage-experiment/recorded-layouts.test.mjs",
        "experiment:coverage:recorded-ambiguity": "node scripts/coverage-experiment/recorded-ambiguity.test.mjs"
    },
    "peerDependencies": {
        "graphql": "16.12.0"
    },
    "devDependencies": {
        "@types/node": "^26.0.1",
        "@vitest/coverage-v8": "5.0.2",
        "@vitest/ui": "5.0.2",
        "@wallpaperdb/crap-typescript-core": "workspace:*",
        "@wallpaperdb/scripts": "workspace:*",
        "@wallpaperdb/vitest-config": "workspace:*",
        "graphql": "16.12.0",
        "turbo": "2.11.10",
        "typescript": "^5.7.2",
        "vitest": "5.0.2",
        "@biomejs/biome": "2.6.2",
        "@wallpaperdb/biome-test-rules": "workspace:*"
    },
    "pnpm": {
        "overrides": {
            "graphql": "16.12.0"
        }
    }
}
