{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "extends": ["./packages/biome-test-rules/test-correctness.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.{js,mjs,cjs,ts,tsx,json,jsonc}",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/build",
      "!!**/coverage",
      "!!**/.next",
      "!!**/.output",
      "!!test/fixtures/crap"
    ]
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noComponentHookFactories": "off"
      }
    }
  }
}
