{
  "name": "@wallpaperdb/user",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose -p $COMPOSE_PROJECT_NAME -f ../../infra/docker-compose.apps.yml watch user",
    "gen:swagger": "tsx src/gen_swagger.ts",
    "build": "node --experimental-strip-types esbuild.config.ts",
    "build:docker": "docker build -t wallpaperdb-user:latest -f Dockerfile ../..",
    "start": "node dist/index.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && node ../../scripts/check-architecture.mjs apps/user",
    "lint:fix": "biome lint --write .",
    "check-types": "tsc --noEmit",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:integration": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format:files": "biome format --write",
    "test:architecture": "node --test ../../scripts/check-architecture.test.mjs",
    "check:architecture": "node ../../scripts/check-architecture.mjs apps/user"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@wallpaperdb/core": "workspace:*",
    "@wallpaperdb/events": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "nats": "^2.29.1",
    "pg": "^8.13.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.23.0",
    "sharp": "^0.33.5",
    "@aws-sdk/client-s3": "^3.709.0",
    "@fastify/multipart": "^9.0.1",
    "@wallpaperdb/profile-markdown": "workspace:*",
    "effect": "4.0.0-rc.115",
    "@effect/opentelemetry": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@clerk/fastify": "^3.1.19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@testcontainers/postgresql": "^11.9.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@wallpaperdb/test-utils": "workspace:*",
    "@wallpaperdb/testcontainers": "workspace:*",
    "@wallpaperdb/test-logger": "workspace:*",
    "@wallpaperdb/vitest-config": "workspace:*",
    "drizzle-kit": "^0.30.1",
    "esbuild": "^0.25.12",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.3",
    "testcontainers": "^11.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "exports": {}
}
