    "evaluation/perceived-red-pagoda-001.json"
  ],
  "workload": {
    "warmup": 1,
    "repeats": 3,
    "concurrency": 1,
    "limit": 20,
    "accuracyLimit": 1000,
    "timeoutMs": 10000
  },
  "candidates": [
