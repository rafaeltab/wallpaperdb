{
  "name": "@wallpaperdb/crap-typescript-core",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "Vendored TypeScript CRAP analyzer with WallpaperDB callback and coverage fixes",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^3.0.0",
    "@wallpaperdb/vitest-config": "workspace:*",
    "vitest": "^3.0.0"
  }
}
