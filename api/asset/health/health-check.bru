meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{assetBaseUrl}}/health
  body: none
  auth: none
}

docs {
  Check if the asset service is healthy (all dependencies operational).

  Returns 200 if healthy, 503 if unhealthy.

  Response includes status of:
  - database (PostgreSQL)
  - s3 (S3 storage)
  - nats (message queue)
}
