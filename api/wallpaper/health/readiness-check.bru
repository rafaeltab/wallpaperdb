meta {
  name: Readiness Check
  type: http
  seq: 2
}

get {
  url: {{wallpaperBaseUrl}}/ready
  body: none
  auth: none
}

docs {
  Check if the wallpaper service is ready to accept requests.

  Returns 200 if ready, 503 if not ready.

  Checks:
  - initialized: application startup has completed
  - PostgreSQL and NATS: both required connections respond
  - shuttingDown: service is not shutting down
}
