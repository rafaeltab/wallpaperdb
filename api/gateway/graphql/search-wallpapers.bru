meta {
  name: Search Wallpapers
  type: graphql
  seq: 1
}

post {
  url: {{gatewayBaseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  query SearchWallpapers($first: Int, $after: String, $filter: WallpaperFilter, $sort: WallpaperSort) {
    searchWallpapers(first: $first, after: $after, filter: $filter, sort: $sort) {
      edges {
        node {
          wallpaperId
          profileId
          uploadedAt
          updatedAt
          variants {
            width
            height
            aspectRatio
            format
            fileSizeBytes
            createdAt
            url
          }
        }
      }
      pageInfo {
        hasNextPage
        hasPreviousPage
        startCursor
        endCursor
      }
    }
  }
}

body:graphql:vars {
  {
    "first": 10,
    "filter": {},
    "sort": {
      "color": {
        "mode": "VIBE",
        "quality": "FAVORITE",
        "targets": [{ "color": "#FF0000" }]
      }
    }
  }
}

docs {
  # Search Wallpapers

  Search wallpapers with optional metadata and Profile filters, color ranking,
  and cursor pagination. See the [authoritative GraphQL schema](https://github.com/rafaeltab/wallpaperdb/blob/main/apps/gateway/src/graphql/schema.ts)
  for the complete input and response contract.

  The request uses one default-quality vibe target, matching the existing picker.
  Add `filter.profileId` to limit results to one contributor Profile. For the
  next page, set `after` to the returned `pageInfo.endCursor` and preserve the
  same filter and sort.
}
