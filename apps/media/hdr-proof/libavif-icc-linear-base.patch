+// Proof-local entry point. Native ICC interpretation supplies the actual
+// compressed base in float32 linear RGB. Equal primaries keep its coordinates
+// unchanged. The original public entry point retains all existing behavior.
+avifResult avifProofComputeGainMapLinearBase(const avifRGBImage * baseRgbImage,
+                                            avifColorPrimaries primaries,
+                                            const float * linearBase,
+                                            size_t linearCount,
+                                            const avifRGBImage * altRgbImage,
+                                            avifTransferCharacteristics altTransfer,
+                                            avifGainMap * gainMap,
+                                            avifDiagnostics * diag)
+{
+    if (!baseRgbImage || !linearBase || linearCount != (size_t)baseRgbImage->width * baseRgbImage->height * 3) {
+        return AVIF_RESULT_INVALID_ARGUMENT;
+    }
+    for (size_t i = 0; i < linearCount; ++i) {
+        if (!isfinite(linearBase[i]) || linearBase[i] < 0.0f || linearBase[i] > 1.000001f) {
+            return AVIF_RESULT_INVALID_ARGUMENT;
+        }
+    }
+    return avifProofComputeGainMap(linearBase, baseRgbImage, primaries, AVIF_TRANSFER_CHARACTERISTICS_LINEAR,
+                                   altRgbImage, primaries, altTransfer, gainMap, diag);
+}
+
+avifResult avifRGBImageComputeGainMap(const avifRGBImage * baseRgbImage,
