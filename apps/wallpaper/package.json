{
  "name": "@wallpaperdb/wallpaper",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose -p $COMPOSE_PROJECT_NAME -f ../../infra/docker-compose.apps.yml watch wallpaper",
    "build": "node --experimental-strip-types esbuild.config.ts",
    "build:docker": "docker build -t wallpaperdb-wallpaper:latest -f Dockerfile ../..",
    "start": "node dist/index.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:architecture": "wallpaperdb-check-architecture apps/wallpaper",
    "lint:fix": "biome lint --write .",
    "check-types": "tsc --noEmit",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:integration": "vitest run --coverage --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "format:files": "biome format --write",
    "test:unit": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "operator": "tsx scripts/operator.ts",
    "gen:swagger": "tsx src/gen_swagger.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@wallpaperdb/core": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "nats": "^2.29.1",
    "zod": "^3.24.1",
    "effect": "4.0.0-rc.115",
    "@effect/opentelemetry": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "pg": "^8.13.1",
    "zod-to-json-schema": "^3.23.0",
    "@wallpaperdb/events": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@wallpaperdb/scripts": "workspace:*",
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^22.10.2",
    "@wallpaperdb/test-utils": "workspace:*",
    "@wallpaperdb/testcontainers": "workspace:*",
    "@wallpaperdb/vitest-config": "workspace:*",
    "esbuild": "^0.25.12",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^11.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "5.0.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1"
  },
  "exports": {}
}
