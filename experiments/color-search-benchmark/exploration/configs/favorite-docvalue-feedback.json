        "bucketCount": 256,
        "cutoffBlendExponent": 1,
        "qualityCurve": "linear",
        "qualityInfluence": 0.5,
        "minimumQuality": 0,
        "namedMode": "concrete-swatches",
        "areaPower": 0.5,
        "qualityPenalty": 0.35,
        "excessPenalty": 1.5,
        "pixelCutoff": 0
      },
