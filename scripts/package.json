{
	"name": "@wallpaperdb/scripts",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"bin": {
		"wallpaperdb-check-architecture": "./check-architecture.mjs",
		"wallpaperdb-crap": "./crap.mts"
	},
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"test:docker-queue": "cd .. && node --test scripts/docker-validation.test.mjs",
		"test:toolchain": "cd .. && node --test scripts/toolchain.test.mjs",
		"test:pr-history": "cd .. && node --test scripts/pr-history.test.mjs",
		"test:pr-history-status": "cd .. && node --test scripts/pr-history-status.test.mjs",
		"check:pr-history": "node check-pr-history.mjs",
		"test:unit": "cd .. && node --test scripts/*.test.mjs scripts/lib/*.test.mjs && scripts/node_modules/.bin/vitest run scripts/ci-runner.test.ts scripts/lib/env-pipeline.test.ts --maxWorkers=1 --no-file-parallelism",
		"test:mutation": "node mutation.mjs",
		"check-types": "tsc --project tsconfig.json",
		"format:files": "biome format --write"
	},
	"dependencies": {
		"@wallpaperdb/crap-typescript-core": "workspace:*",
		"istanbul-lib-coverage": "3.2.2",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@types/istanbul-lib-coverage": "2.0.6",
		"@types/node": "^26.0.1",
		"tsx": "^4.22.4",
		"typescript": "^5.7.2",
		"vitest": "5.0.2"
	}
}
