import { reportSchema } from "./json.mjs";
import type { Report, GeneratedSources } from "./contract.mjs";
import assert from "node:assert/strict";
import { readFile } from "node:fs/promises";
import { relative, resolve, isAbsolute } from "node:path";
import { createHash } from "node:crypto";
import { coverageMap } from "./publish-reports.mjs";
const hash = (bytes: string | Uint8Array) =>
	createHash("sha256").update(bytes).digest("hex");

// Generated mock plumbing is measured, but is not an original application body.
// Retain it with its exact generated bytes; never add it to application totals.
export async function reportInput(
	input: unknown,
	root: string,
	workspace: string,
	retained?: GeneratedSources,
) {
	const raw = reportSchema.parse(input);
	const original: Report = {},
		generated: GeneratedSources = {};
	for (const [path, file] of Object.entries(raw)) {
		assert.equal(file.path, path, "Coverage key/path mismatch");
		const generatedPath = relative(root, path).replaceAll("\\", "/");
		if (
			/^\.coverage-runtime\/native-sources-[^/]+\/[a-f0-9]{64}\.js$/.test(
				generatedPath,
			)
		) {
			coverageMap({ [path]: file });
			const source = retained
				? retained[path]?.source
				: await readFile(path, "utf8");
			assert.equal(typeof source, "string", "Missing generated mock source");
			generated[path] = generatedSource(path, source, file, retained);
		} else {
			const local = relative(resolve(root, workspace), path);
			assert.ok(
				local && !local.startsWith("..") && !isAbsolute(local),
				`Coverage path is outside its workspace: ${path}`,
			);
			original[path] = file;
		}
	}
	if (retained)
		assert.deepEqual(
			Object.keys(generated).sort(),
			Object.keys(retained).sort(),
			"Generated source inventory changed",
		);
	return { original, generated };
}

function generatedSource(
	path: string,
	source: string,
	file: Report[string],
	retained?: GeneratedSources,
) {
	const sha256 = hash(source);
	if (retained) {
		assert.equal(
			retained[path].sha256,
			sha256,
			"Generated mock source changed",
		);
		assert.deepEqual(
			retained[path].coverage,
			file,
			"Generated mock counters changed",
		);
	}
	return { source, sha256, coverage: structuredClone(file) };
}
