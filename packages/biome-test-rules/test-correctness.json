{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"plugins": [
		{
			"path": "./rules/correctness.ts",
			"resolutionKind": "config",
			"includes": [
				"**/*.{test,spec}.{js,mjs,ts,tsx}",
				"**/{test,tests,specs}/**/*.{js,mjs,ts,tsx}",
				"!**/node_modules/**",
				"!**/{dist,build,coverage,.next,.output}/**",
				"!**/test/fixtures/crap/**"
			]
		}
	],
	"overrides": [
		{
			"includes": [
				"**/*.{test,spec}.{js,mjs,ts,tsx}",
				"**/{test,tests,specs}/**/*.{js,mjs,ts,tsx}",
				"!**/node_modules/**",
				"!**/{dist,build,coverage,.next,.output}/**",
				"!**/test/fixtures/crap/**"
			],
			"linter": {
				"rules": {
					"nursery": {
						"noJsRestrictedProperties": {
							"level": "error",
							"options": {
								"entries": [
									{
										"object": "it",
										"property": "todo",
										"message": "Track unfinished tests in an issue rather than a passing placeholder."
									},
									{
										"object": "test",
										"property": "todo",
										"message": "Track unfinished tests in an issue rather than a passing placeholder."
									},
									{
										"object": "describe",
										"property": "todo",
										"message": "Track unfinished tests in an issue rather than a passing placeholder."
									},
									{
										"object": "suite",
										"property": "todo",
										"message": "Track unfinished tests in an issue rather than a passing placeholder."
									}
								]
							}
						}
					},
					"suspicious": {
						"noFocusedTests": "error",
						"noSkippedTests": "error",
						"noSelfCompare": "error"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.{test,spec}.{ts,tsx}",
				"**/{test,tests,specs}/**/*.{ts,tsx}",
				"!**/node_modules/**",
				"!**/{dist,build,coverage,.next,.output}/**",
				"!**/test/fixtures/crap/**"
			],
			"linter": {
				"rules": {
					"nursery": {
						"noFloatingPromises": "error"
					}
				}
			}
		}
	]
}
