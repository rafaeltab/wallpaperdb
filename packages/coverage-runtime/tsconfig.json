{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "sourceMap": true,
    "inlineSources": true
  },
  "include": [
    "src/**/*.mts",
    "src/**/*.ts"
  ]
}
