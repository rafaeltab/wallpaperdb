# These values are for host-based development (running services directly on the host).
# For Docker-based development, run `pnpm install` to generate .env files with
# Docker-internal hostnames and worktree-specific ports via scripts/setup-worktree.mjs.
# Do not edit the generated .env files directly - they will be regenerated on install.

# Server Configuration
PORT=3009
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://wallpaperdb:wallpaperdb@localhost:5432/wallpaperdb_user

# NATS
NATS_URL=nats://localhost:4222
NATS_STREAM=WALLPAPER

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=user

# Clerk (authentication webhooks)
CLERK_SECRET_KEY=replace_with_valid_clerk_secret_key
CLERK_PUBLISHABLE_KEY=replace_with_valid_clerk_publishable_key

# Profile handles
PROFILE_HANDLE_MIN_LENGTH=1
PROFILE_HANDLE_MAX_LENGTH=30
PROFILE_DISPLAY_NAME_MAX_LENGTH=80
PROFILE_RETAINED_ALIAS_LIMIT=3

# Biography Markdown, counted as Unicode code points.
PROFILE_BIOGRAPHY_MAX_LENGTH=5000

# Profile pictures: this bucket must never allow anonymous object downloads.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
PROFILE_PICTURE_BUCKET=profile-pictures
PROFILE_PICTURE_MAX_BYTES=5242880
PROFILE_PICTURE_MAX_PIXELS=16000000
PROFILE_PICTURE_MAX_DECODED_BYTES=67108864
PROFILE_PICTURE_IMPORT_HOSTS=img.clerk.com,images.clerk.dev
PROFILE_PICTURE_IMPORT_TIMEOUT_MS=10000

# Shared with Media. Worktree setup generates a persistent random token.
USER_MEDIA_SERVICE_TOKEN=
