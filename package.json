{
    "name": "@wallpaperdb/root",
    "version": "0.0.1",
    "type": "module",
    "packageManager": "pnpm@10.18.3",
    "engines": {
        "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
    },
    "scripts": {
        "postinstall": "test -f scripts/setup-worktree.mjs && node scripts/setup-worktree.mjs || true",
        "test": "vitest",
        "architecture:workspaces": "node scripts/check-architecture-workspaces.mjs",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "coverage:merge": "mkdir -p coverage && find packages apps -path '*/coverage/*' -name lcov.info -exec cat {} + > coverage/lcov.info",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "check-types": "tsc --project tsconfig.tooling.json"
    },
    "peerDependencies": {
        "graphql": "16.12.0"
    },
    "devDependencies": {
        "@types/node": "^26.0.1",
        "@vitest/coverage-v8": "5.0.2",
        "@vitest/ui": "5.0.2",
        "@wallpaperdb/crap-typescript-core": "workspace:*",
        "@wallpaperdb/scripts": "workspace:*",
        "@wallpaperdb/vitest-config": "workspace:*",
        "graphql": "16.12.0",
        "turbo": "^2.6.1",
        "typescript": "^5.7.2",
        "vitest": "5.0.2"
    },
    "pnpm": {
        "overrides": {
            "graphql": "16.12.0"
        }
    }
}
