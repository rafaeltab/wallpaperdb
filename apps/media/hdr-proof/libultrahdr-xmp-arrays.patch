+// Adobe gain-map channel properties may be scalar elements or three-item
+// rdf:Seq arrays. Keep this separate from the existing Apple/scalar handler:
+// nested array endings must not discard the surrounding property name.
+class GainMapChannelElements : public XmlHandler {
+  struct Node {
+    string name;
+    string text;
+    vector<Node> children;
+  };
+  struct Values {
+    bool valid = false;
+    float channels[3] = {0, 0, 0};
+  };
+  vector<Node> stack;
+  map<string, Values> properties;
+
+  static bool channelProperty(const string& name) {
+    return name == "hdrgm:GainMapMin" || name == "hdrgm:GainMapMax" ||
+           name == "hdrgm:Gamma" || name == "hdrgm:OffsetSDR" || name == "hdrgm:OffsetHDR";
+  }
+
+  static bool whitespace(const string& value) {
+    return value.find_first_not_of(" \t\r\n") == string::npos;
+  }
+
+  static bool number(const string& text, float* value) {
+    stringstream stream(text);
+    if (!(stream >> *value) || !std::isfinite(*value)) return false;
+    stream >> std::ws;
+    return stream.eof();
+  }
+
+ public:
+  DataMatchResult StartElement(const XmlTokenContext& context) override {
+    string name;
+    if (context.BuildTokenValue(&name)) stack.push_back({name, "", {}});
+    return context.GetResult();
+  }
+
+  DataMatchResult ElementContent(const XmlTokenContext& context) override {
+    string value;
+    if (!stack.empty() && context.BuildTokenValue(&value)) stack.back().text += value;
+    return context.GetResult();
+  }
+
+  DataMatchResult FinishElement(const XmlTokenContext& context) override {
+    if (stack.empty()) return context.GetResult();
+    Node node = std::move(stack.back());
+    stack.pop_back();
+    if (channelProperty(node.name) && !stack.empty() && stack.back().name == "rdf:Description") {
+      Values values;
+      if (properties.count(node.name)) {
+        // Repeated properties are ambiguous, including a malformed second one.
+        properties[node.name].valid = false;
+      } else {
+        if (node.children.empty()) {
+          values.valid = number(node.text, &values.channels[0]);
+          values.channels[1] = values.channels[2] = values.channels[0];
+        } else if (whitespace(node.text) && node.children.size() == 1 &&
+                   node.children[0].name == "rdf:Seq" && whitespace(node.children[0].text) &&
+                   node.children[0].children.size() == 3) {
+          values.valid = true;
+          for (size_t c = 0; c < 3; ++c) {
+            const Node& item = node.children[0].children[c];
+            values.valid &= item.name == "rdf:li" && item.children.empty() &&
+                            number(item.text, &values.channels[c]);
+          }
+        }
+        properties[node.name] = values;
+      }
+    }
+    if (!stack.empty()) stack.back().children.push_back(std::move(node));
+    return context.GetResult();
+  }
+
+  bool has(const string& name) const { return properties.count(name) != 0; }
+
+  bool get(const string& name, float* values, bool logarithmic) const {
+    auto found = properties.find(name);
+    if (found == properties.end() || !found->second.valid) return false;
+    for (size_t c = 0; c < 3; ++c) {
+      values[c] = logarithmic ? exp2(found->second.channels[c]) : found->second.channels[c];
+      if (!std::isfinite(values[c])) return false;
+    }
+    return true;
+  }
+};
 
