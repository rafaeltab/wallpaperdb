        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "(max(admission_usage_points and (time() - admission_usage_observed_at < 30) and (admission_usage_minute == (time() - time() % 60))) / (max(admission_usage_active_ips and (time() - admission_usage_observed_at < 30) and (admission_usage_minute == (time() - time() % 60))) > 0)) and ((min(admission_usage_available and (time() - admission_usage_observed_at < 30)) == 1) and (min(admission_usage_minute and (time() - admission_usage_observed_at < 30)) == (time() - time() % 60)) and (min(admission_usage_sampled_at and (time() - admission_usage_observed_at < 30)) > time() - 30))",
          "legendFormat": "Shared points / active IP",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Mean charged points per active IP this minute",
      "type": "stat",
      "description": "Fleet-wide shared charged points divided by the HyperLogLog estimate of distinct charged IPs in the current UTC minute. Only positive charges participate. Replica samples repeat the same shared state and are deduplicated before division; the mean may decrease when new IPs do cheaper work. No IP identities or per-IP percentiles are exported. Unavailable if any reporting replica cannot read shared usage, samples are stale, the minute changes before the next collection, or no IP has charged work. Local fallback charges are not included. Retired replica samples expire after 30 seconds."
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "id": 12,
      "title": "Distributed quota fallback, recovery, and saturation",
      "description": "Fallback uses independent replica budgets. Recovery resumes Redis without merging outage charges. Saturation rejects with 503. No identity labels are exported.",
