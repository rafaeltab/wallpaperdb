# Host-run operational infrastructure. No product Compose dependency.
FACTORY_HOST=127.0.0.1
FACTORY_PORT=8008
FACTORY_T3_PROJECT_ID=
FACTORY_PROJECT=
# Pin a verified commit and installed headless-capable T3 binary before startup.
FACTORY_BASE=
FACTORY_T3_BINARY=
# Existing private local Linux directory outside the installation.
FACTORY_STATE=
# Operator-verified prerequisite acceptance/review/CI at issue/pr/commit.
FACTORY_PREREQUISITES=[]
# Optional OTLP HTTP collector base URL. Disabled when absent.
# FACTORY_OTEL_ENDPOINT=http://127.0.0.1:4318
