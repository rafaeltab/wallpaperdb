# syntax=docker/dockerfile:1.20

# Development Dockerfile for @wallpaperdb/web
#
# Build context: repo root (pass -f apps/web/Dockerfile.dev to docker build)
# The entire monorepo is copied so workspace dependencies are available.
# node_modules are baked into the image; the entrypoint re-installs if
# pnpm-lock.yaml changes (e.g. via docker compose watch sync).
#
# Vite is started with --host to bind to all interfaces inside the container.
# The VITE_BASE_PATH env var is set in apps/web/.env (generated by setup-worktree.mjs).

FROM node:22.22.3-alpine

WORKDIR /app

# System dependencies
RUN apk update && apk add --no-cache libc6-compat python3 make g++

# Set up pnpm via corepack, using the root packageManager declaration
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
COPY package.json ./
RUN corepack enable && corepack prepare "$(node -p 'require("./package.json").packageManager')" --activate

# Preserve workspace paths, lifecycle inputs, and local executable targets.
COPY --parents package.json pnpm-lock.yaml pnpm-workspace.yaml \
    apps/*/package.json packages/*/package.json experiments/*/package.json \
    infra/package.json scripts/package.json ./
COPY --parents apps/docs/source.config.ts apps/docs/content \
    scripts/check-architecture.mjs scripts/crap.mts \
    scripts/setup-worktree.mjs scripts/lib/worktree-project.mjs \
    scripts/lib/env-pipeline.mjs ./

COPY patches/ ./patches/

# Install all workspace dependencies and record the lockfile hash so the
# entrypoint can detect changes and re-install when the lockfile is synced.
RUN pnpm install --frozen-lockfile && \
    sha256sum pnpm-lock.yaml | cut -d' ' -f1 > .pnpm-lockfile-hash

# Application edits reuse the dependency installation above.
COPY . .

# Vite imports workspace packages through their built public entry points.
RUN pnpm exec turbo run build --filter='@wallpaperdb/web^...'

# Install the shared entrypoint script
RUN cp scripts/entrypoint.sh /entrypoint.sh && chmod +x /entrypoint.sh

WORKDIR /app/apps/web

ENTRYPOINT ["/entrypoint.sh"]
CMD ["pnpm", "exec", "vite", "--port", "3005", "--host"]
