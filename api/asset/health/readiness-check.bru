meta {
  name: Readiness Check
  type: http
  seq: 2
}

get {
  url: {{assetBaseUrl}}/ready
  body: none
  auth: none
}

docs {
  Check if the asset service is ready to handle requests.

  Returns 200 if ready, 503 if not ready (e.g., shutting down or connections not initialized).

  Used for Kubernetes readiness probes.
}
