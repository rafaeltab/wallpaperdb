{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"plugins": [
		{
			"path": "./rules/correctness.ts",
			"resolutionKind": "config",
			"includes": [
				"**/*.{test,spec}.{js,mjs,ts,tsx}",
				"**/{test,tests,specs}/**/*.{js,mjs,ts,tsx}",
				"!**/node_modules/**",
				"!**/{dist,build,coverage,.next,.output}/**",
				"!**/test/fixtures/crap/**"
			]
		}
	],
	"overrides": [
		{
			"includes": [
				"**/*.{test,spec}.{js,mjs,ts,tsx}",
				"**/{test,tests,specs}/**/*.{js,mjs,ts,tsx}",
				"!**/node_modules/**",
				"!**/{dist,build,coverage,.next,.output}/**",
				"!**/test/fixtures/crap/**"
			],
			"linter": {
				"rules": {
					"nursery": {
						"noFloatingPromises": "error"
					},
					"suspicious": {
						"noFocusedTests": "error",
						"noSkippedTests": "error",
						"noSelfCompare": "error"
					}
				}
			}
		},
		{
			"includes": ["**/specs/**/*.{spec,setup}.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noPlaywrightMissingAwait": "error"
					}
				}
			}
		}
	]
}
