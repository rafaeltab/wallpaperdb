{
    "$schema": "https://turbo.build/schema.json",
    "globalPassThroughEnv": [
        "GITHUB_ACTIONS",
        "COMPOSE_PROJECT_NAME"
    ],
    "globalDependencies": [
        "packages/vitest-config/src/**",
        "packages/test-logger/src/**"
    ],
    "tasks": {
        "start": {
            "cache": false,
            "persistent": true
        },
        "stop": {
            "cache": false
        },
        "reset": {
            "cache": false
        },
        "logs": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": [
                "^build",
                "gen:swagger-pages"
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "build/**"
            ]
        },
        "build:docker": {
            "dependsOn": [
                "build"
            ],
            "cache": false,
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": [
                "^build",
                "lint:architecture"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/biome.json",
                "$TURBO_ROOT$/packages/biome-test-rules/test-correctness.json",
                "$TURBO_ROOT$/packages/biome-test-rules/src/**"
            ]
        },
        "lint:architecture": {
            "dependsOn": [
                "//#architecture:workspaces"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/scripts/check-architecture.mjs"
            ]
        },
        "//#architecture:workspaces": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/scripts/check-architecture-workspaces.mjs",
                "$TURBO_ROOT$/scripts/check-architecture.mjs",
                "$TURBO_ROOT$/apps/*/package.json",
                "$TURBO_ROOT$/apps/*/Dockerfile",
                "$TURBO_ROOT$/apps/*/quality.config.json",
                "$TURBO_ROOT$/apps/*/src/**",
                "$TURBO_ROOT$/apps/*/test/**",
                "$TURBO_ROOT$/apps/*/scripts/**",
                "$TURBO_ROOT$/packages/*/src/**",
                "$TURBO_ROOT$/packages/*/test/**",
                "$TURBO_ROOT$/packages/*/scripts/**"
            ]
        },
        "lint:fix": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/biome.json",
                "$TURBO_ROOT$/packages/biome-test-rules/test-correctness.json",
                "$TURBO_ROOT$/packages/biome-test-rules/src/**"
            ]
        },
        "format": {
            "cache": false
        },
        "format:check": {
            "cache": false
        },
        "check": {
            "cache": false
        },
        "test": {
            "cache": true,
            "inputs": [
                "src/**",
                "test/**",
                "vitest.*.ts",
                "package.json",
                "package-lock.json"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "test:unit": {
            "cache": true,
            "inputs": [
                "$TURBO_DEFAULT$"
            ],
            "outputs": [
                "coverage/unit/**"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "test:mutation": {
            "cache": false,
            "dependsOn": ["^build"],
            "outputs": ["reports/mutation/**"]
        },
        "test:integration": {
            "cache": true,
            "inputs": [
                "$TURBO_DEFAULT$"
            ],
            "outputs": [
                "coverage/integration/**"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "test:e2e": {
            "cache": false,
            "inputs": [
                "src/**",
                "test/**",
                "playwright.config.ts",
                "vitest.*.ts",
                "package.json"
            ],
            "outputs": [
                "coverage/**",
                "playwright-report/**",
                "test-results/**"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "check-types": {
            "dependsOn": [
                "^build"
            ],
            "cache": true,
            "inputs": [
                "$TURBO_DEFAULT$"
            ]
        },
        "gen:swagger": {
            "cache": true,
            "inputs": [
                "src/**",
                "package.json",
                "package-lock.json",
                "tsconfig.json"
            ],
            "outputs": [
                "swagger.json"
            ]
        },
        "gen:swagger-pages": {
            "cache": true,
            "dependsOn": [
                "^gen:swagger"
            ],
            "outputs": [
                "content/docs/openapi/**"
            ]
        },
        "db:migrate": {
            "cache": false
        },
        "//#test:integration": {
            "dependsOn": [
                "@wallpaperdb/vitest-config#build"
            ],
            "inputs": [
                "package.json",
                "pnpm-lock.yaml",
                "vitest.integration.config.ts",
                "test/integration/**",
                "test/fixtures/crap/**",
                "$TURBO_ROOT$/apps/gateway/package.json",
                "$TURBO_ROOT$/apps/gateway/vitest.config.ts",
                "$TURBO_ROOT$/apps/asset/package.json",
                "$TURBO_ROOT$/apps/asset/vitest*.config.ts",
                "$TURBO_ROOT$/apps/user/package.json",
                "$TURBO_ROOT$/apps/user/vitest*.config.ts",
                "$TURBO_ROOT$/apps/ingestor/package.json",
                "$TURBO_ROOT$/apps/ingestor/vitest.config.ts",
                "$TURBO_ROOT$/apps/{gateway,asset,user,ingestor}/src/**",
                "$TURBO_ROOT$/apps/{gateway,asset,user,ingestor}/test/**",
                "$TURBO_ROOT$/packages/crap-typescript-core/src/**",
                "$TURBO_ROOT$/packages/crap-typescript-core/package.json"
            ],
            "outputs": []
        },
        "//#check-types": {
            "dependsOn": [
                "@wallpaperdb/vitest-config#build"
            ],
            "inputs": [
                "package.json",
                "pnpm-lock.yaml",
                "tsconfig.tooling.json",
                "apps/*/vitest*.ts",
                "packages/*/vitest*.ts",
                "apps/*/package.json",
                "packages/*/package.json",
                "crap.config.mts",
                "test/integration/**",
                "vitest.integration.config.ts",
                "$TURBO_ROOT$/packages/crap-typescript-core/src/**",
                "$TURBO_ROOT$/packages/crap-typescript-core/package.json"
            ],
            "outputs": []
        },
        "@wallpaperdb/scripts#test:unit": {
            "cache": false
        },
        "@wallpaperdb/scripts#check-types": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/crap.config.mts",
                "$TURBO_ROOT$/packages/crap-typescript-core/src/**",
                "$TURBO_ROOT$/packages/crap-typescript-core/package.json"
            ],
            "outputs": []
        },
        "@wallpaperdb/web#test:integration": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/pnpm-lock.yaml",
                "$TURBO_ROOT$/apps/web-e2e/fixtures/profile-*.png"
            ],
            "outputs": [
                "coverage/integration/**"
            ]
        },
        "@wallpaperdb/infra-local#test:unit": {
            "inputs": [
                "$TURBO_DEFAULT$"
            ],
            "outputs": []
        },
        "//#lint": {
            "inputs": [
                "test/**",
                "biome.json",
                "packages/biome-test-rules/test-correctness.json",
                "packages/biome-test-rules/src/**",
                "package.json",
                "pnpm-lock.yaml"
            ],
            "outputs": []
        },
        "@wallpaperdb/biome-test-rules#test:unit": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/crap.config.mts",
                "$TURBO_ROOT$/mutation.inventory.json",
                "$TURBO_ROOT$/scripts/mutation.mjs",
                "$TURBO_ROOT$/scripts/lib/mutation-*.mjs",
                "$TURBO_ROOT$/apps/*/mutation.config.json",
                "$TURBO_ROOT$/packages/*/mutation.config.json",
                "$TURBO_ROOT$/experiments/*/package.json",
                "$TURBO_ROOT$/Makefile",
                "$TURBO_ROOT$/mise.toml",
                "$TURBO_ROOT$/mise.lock",
                "$TURBO_ROOT$/.npmrc",
                "$TURBO_ROOT$/scripts/mise-shell.sh",
                "$TURBO_ROOT$/scripts/toolchain.mjs",
                "$TURBO_ROOT$/biome.json",
                "$TURBO_ROOT$/.gitignore",
                "$TURBO_ROOT$/scripts/biome.json",
                "$TURBO_ROOT$/infra/biome.json",
                "$TURBO_ROOT$/turbo.json",
                "$TURBO_ROOT$/pnpm-workspace.yaml",
                "$TURBO_ROOT$/package.json",
                "$TURBO_ROOT$/pnpm-lock.yaml",
                "$TURBO_ROOT$/apps/*/package.json",
                "$TURBO_ROOT$/packages/*/package.json",
                "$TURBO_ROOT$/apps/*/biome.json",
                "$TURBO_ROOT$/packages/*/biome.json",
                "$TURBO_ROOT$/scripts/package.json",
                "$TURBO_ROOT$/infra/package.json",
                "$TURBO_ROOT$/apps/*/{test,tests,specs}/**",
                "$TURBO_ROOT$/packages/*/{test,tests,specs}/**",
                "$TURBO_ROOT$/apps/*/src/**/*.{test,spec}.{ts,tsx,js,jsx,mjs}",
                "$TURBO_ROOT$/packages/*/src/**/*.{test,spec}.{ts,tsx,js,jsx,mjs}"
            ],
            "outputs": [
                "coverage/unit/**"
            ]
        }
    }
}
