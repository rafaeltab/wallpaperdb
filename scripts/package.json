{
	"name": "@wallpaperdb/scripts",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"bin": {
		"wallpaperdb-check-architecture": "./check-architecture.ts",
		"wallpaperdb-crap": "./crap.mts"
	},
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"test:docker-queue": "cd .. && scripts/node_modules/.bin/vitest run scripts/docker-validation.test.ts",
		"test:toolchain": "cd .. && scripts/node_modules/.bin/vitest run scripts/toolchain.test.ts",
		"test:unit": "cd .. && scripts/node_modules/.bin/vitest run",
		"test:mutation": "node mutation.ts",
		"check-types": "tsc --project tsconfig.json && tsc --project tsconfig.external.json",
		"format:files": "biome format --write",
		"test:operator-inbox": "cd .. && scripts/node_modules/.bin/vitest run scripts/operator-inbox.test.ts",
		"test:coverage-runtime": "cd .. && make test-unit PACKAGE=coverage-runtime",
		"coverage": "node ../packages/coverage-runtime/dist/command.mjs",
		"coverage:inventory": "cd .. && node packages/coverage-runtime/dist/inventory.mjs",
		"coverage:build": "cd .. && node scripts/dist/coverage-build.mjs",
		"coverage:tier": "node ../packages/coverage-runtime/dist/run-tier.mjs",
		"build": "rm -rf dist && tsc --project tsconfig.coverage.json",
		"lint:fix": "biome lint --write ."
	},
	"dependencies": {
		"@wallpaperdb/crap-typescript-core": "workspace:*",
		"istanbul-lib-coverage": "3.2.2",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@wallpaperdb/coverage-runtime": "workspace:*",
		"ast-v8-to-istanbul": "1.0.6"
	},
	"devDependencies": {
		"@wallpaperdb/vitest-config": "workspace:*",
		"@biomejs/biome": "2.6.2",
		"@types/istanbul-lib-coverage": "2.0.6",
		"@types/node": "^26.0.1",
		"tsx": "^4.22.4",
		"typescript": "^5.7.2",
		"vitest": "5.0.2"
	}
}
